SQL> create or replace function get_count (tab_name varchar2) return number AUTHID CURRENT_USER as
  2  cur integer := NULL;
  3  sql_text varchar2(32767);
  4  rowcount NUMBER;
  5  row_proc integer;
  6  BEGIN
  7  	 cur:=dbms_sql.open_cursor;
  8  	 sql_text:='select count(1) rowcount from '||dbms_assert.sql_object_name(tab_name);
  9  	 dbms_sql.parse(cur,sql_text,dbms_sql.NATIVE);
 10  	 dbms_sql.define_column(cur,1,rowcount);
 11  	 row_proc:=dbms_sql.execute(cur);
 12  	 row_proc:=dbms_sql.fetch_rows(cur);
 13  	 dbms_sql.column_value(cur,1,rowcount);
 14  	 dbms_sql.close_cursor(cur);
 15  	 return rowcount;
 16  exception
 17   when others then
 18    if cur is not null and dbms_sql.is_open(cur) then dbms_sql.close_cursor(cur); end if;
 19    raise;
 20  end;
 21  /

Function created.

